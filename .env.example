# Configuración de la aplicación
FLASK_ENV=production
FLASK_DEBUG=False

# Inicio de temporada (formato YYYY-MM-DD)
SEASON_START_DATE=2026-04-20

# Host y puerto
FLASK_HOST=0.0.0.0
FLASK_PORT=3000

# Prefix para Coolify
SCRIPT_NAME=/facu-demo

# Autenticacion (cambiar en produccion)
ADMIN_USER=admin
ADMIN_PASSWORD=f1demo2025
SECRET_KEY=cambia-esto-por-un-valor-secreto-largo

# Cloudinary (opcional, recomendado para persistir estado y fotos en Render Free)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REMOTE_STATE_SYNC=true
